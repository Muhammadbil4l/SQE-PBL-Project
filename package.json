{
  "name": "student-crud-api",
  "version": "1.0.0",
  "description": "CRUD REST API for managing Student records (Express + SQLite) - SW426 Software Quality Engineering PBL",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/api.test.js",
    "postman": "npx --yes newman run postman/Student_API.postman_collection.json -e postman/Local.postman_environment.json"
  },
  "keywords": [
    "rest-api",
    "crud",
    "express",
    "sqlite",
    "postman"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}