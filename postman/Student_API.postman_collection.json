              "raw": "{{baseUrl}}/api/students/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "999999"
              ]
            },
            "description": "ID 999999 does not exist. Expected: 404."
          }
        },
        {
          "name": "TC11 - ERROR: Update non-existent ID (PUT)",
          "event": [
            {
